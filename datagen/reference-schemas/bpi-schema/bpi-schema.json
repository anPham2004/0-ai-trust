      ]
    },
    "LoanApplication": {
      "description": "Case-level view of a single loan application aggregated from all events",
      "source": "bpi_2017_cleaned.csv (derived; one record per case:concept:name)",
      "dataContract": {
        "required": [
          "application_id",
          "application_type",
          "loan_goal",
          "requested_amount"
        ],
        "fields": {
          "application_id": {
            "type": "string",
            "description": "Unique loan application identifier",
            "constraints": [
              "Derived from case:concept:name",
              "Format: Application_XXXXXXXXX"
            ]
          },
          "application_type": {
            "type": "string",
            "format": "enum",
            "description": "Type of credit application",
            "enum": {
              "Limit raise": "Request to raise existing credit limit",
              "New credit": "Application for new credit product"
            },
            "constraints": [
              "Derived from case:ApplicationType"
            ]
          },
          "loan_goal": {
            "type": "string",
            "format": "enum",
            "description": "Purpose of the loan as stated by applicant",
            "enum": {
              "Boat": "Purchase of a boat",
              "Business goal": "Business-related funding",
              "Car": "Purchase of a car",
              "Caravan / Camper": "Purchase of caravan or camper",
              "Existing loan takeover": "Refinancing an existing loan",
              "Extra spending limit": "Increasing credit limit",
              "Home improvement": "Home renovation or improvement",
              "Motorcycle": "Purchase of a motorcycle",
              "Not speficied": "Loan goal not specified by applicant",
              "Other see explanation": "Other goal with explanation provided",
              "Remaining debt home": "Paying off remaining home debt",
              "Tax payments": "Covering tax obligations",
              "Unknown": "Loan goal unknown"
            },
            "constraints": [
              "Derived from case:LoanGoal"
            ]
          },
          "requested_amount": {
            "type": "decimal",
            "format": "float",
            "description": "Loan amount requested by the applicant in euros",
            "constraints": [
              "Derived from case:RequestedAmount"
            ]
          },
          "final_status": {
            "type": "string",
            "format": "enum",
            "description": "Outcome derived from the last A_* activity in the case",
            "enum": {
              "Accepted": "Application was accepted",
              "Denied": "Application was denied",
              "Cancelled": "Application was cancelled",
              "Complete": "Application processing fully completed",
              "Incomplete": "Application remained incomplete",
              "Pending": "Application still pending at end of log"
            },
            "constraints": [
              "Derived from last A_* concept:name event",
              "May be null if only workflow events are present"
            ]
          },
          "credit_score": {
            "type": "decimal",
            "format": "float",
            "description": "Credit score recorded during offer creation",
            "constraints": [
              "Derived from CreditScore field on offer events",
              "Range: 0–1000+",
              "Null when no credit score was assessed"
            ]
          },
          "num_offers": {
            "type": "integer",
            "description": "Count of O_Create Offer events for this case",
            "constraints": [
              "Derived by counting concept:name = 'O_Create Offer' events",
              "0 if no offers were created"
            ]
          },
          "accepted_offer_amount": {
            "type": "decimal",
            "format": "float",
            "description": "OfferedAmount from the offer where Accepted=True",
            "constraints": [
              "Null if no offer was accepted",
              "May differ from requested_amount"
            ]
          },
          "monthly_cost": {
            "type": "decimal",
            "format": "float",
            "description": "MonthlyCost from the offer where Selected=True",
            "constraints": [
              "Null if no offer was selected"
            ]
          },
          "number_of_terms": {
            "type": "integer",
            "description": "NumberOfTerms from the offer where Selected=True",
            "constraints": [
              "Derived from NumberOfTerms (stored as float; cast to int)",
              "Null if no offer was selected"
            ]
          },
          "total_events": {
            "type": "integer",
            "description": "Total number of events for this case",
            "constraints": [
              "Count of all rows sharing the same case:concept:name"
            ]
          }
        }
      },
