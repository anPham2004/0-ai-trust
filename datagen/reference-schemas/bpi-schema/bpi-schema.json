{
  "meta": {
    "title": "BPI Challenge 2017 -- Loan Application Event Log Schema Catalog",
    "version": "1.0.0",
    "generatedAt": "2026-07-16",
    "description": "Schema catalog for the BPI Challenge 2017 dataset from a Dutch financial institution's loan application process. Contains 2 entity types: LoanApplicationEvent (raw event log rows) and LoanApplication (case-level aggregated view). Source CSV has ~1.2M rows, 19 columns, covering the period 2016–2017."
  },
  "entities": {
    "LoanApplicationEvent": {
      "description": "Single event in a loan application lifecycle process mining log",
      "source": "bpi_2017_cleaned.csv",
      "dataContract": {
        "required": [
          "Action",
          "concept:name",
          "EventOrigin",
          "EventID",
          "lifecycle:transition",
          "time:timestamp",
          "org:resource",
          "case:concept:name",
          "case:LoanGoal",
          "case:ApplicationType",
          "case:RequestedAmount"
        ],
        "fields": {
          "Action": {
            "type": "string",
            "format": "enum",
            "description": "High-level action type for this event",
            "enum": {
              "Created": "A new entity (application or offer) was created",
              "Deleted": "An entity was deleted",
              "Obtained": "A resource or value was obtained",
              "Released": "A resource was released",
              "statechange": "Internal state transition occurred"
            },
            "constraints": [
              "5 distinct values"
            ]
          },
          "org:resource": {
            "type": "string",
            "description": "Anonymized staff ID who performed the event",
            "constraints": [
              "Format: User_N where N is 1–102+",
              "76 distinct values in sample"
            ]
          },
          "concept:name": {
            "type": "string",
            "format": "enum",
            "description": "Activity name; identifies the process step",
            "enum": {
              "A_Create Application": "Application entity created",
              "A_Submitted": "Application submitted by customer",
              "A_Accepted": "Application accepted by institution",
              "A_Denied": "Application denied",
              "A_Cancelled": "Application cancelled",
              "A_Complete": "Application processing completed",
              "A_Concept": "Application in concept/draft state",
              "A_Incomplete": "Application marked incomplete",
              "A_Pending": "Application pending review",
              "A_Validating": "Application under validation",
              "O_Accepted": "Offer accepted by customer",
              "O_Cancelled": "Offer cancelled",
              "O_Create Offer": "New offer created for application",
              "O_Created": "Offer entity created",
              "O_Refused": "Offer refused by customer",
              "O_Returned": "Offer returned for revision",
              "O_Sent (mail and online)": "Offer sent via mail and online",
              "O_Sent (online only)": "Offer sent via online channel only",
              "W_Assess potential fraud": "Workflow task: fraud assessment",
              "W_Call after offers": "Workflow task: follow-up call after offers",
              "W_Call incomplete files": "Workflow task: call about incomplete files",
              "W_Complete application": "Workflow task: complete application processing",
              "W_Handle leads": "Workflow task: handle new leads",
              "W_Validate application": "Workflow task: validate application details"
            },
            "constraints": [
              "24 distinct values",
              "Prefix A_ = Application activity, O_ = Offer activity, W_ = Workflow task"
            ]
          },
          "EventOrigin": {
            "type": "string",
            "format": "enum",
            "description": "System origin that generated the event",
            "enum": {
              "Application": "Event originated from the application system",
              "Offer": "Event originated from the offer system",
              "Workflow": "Event originated from the workflow engine"
            },
            "constraints": [
              "3 distinct values"
            ]
          },
          "EventID": {
            "type": "string",
            "description": "Unique event identifier",
            "constraints": [
              "Format: ApplState_*, Offer_*, or Application_*",
              "High cardinality"
            ]
          },
          "lifecycle:transition": {
            "type": "string",
            "format": "enum",
            "description": "WfMC lifecycle phase of this event",
            "enum": {
              "ate_abort": "Activity aborted after start",
              "complete": "Activity completed normally",
              "resume": "Activity resumed after suspension",
              "schedule": "Activity scheduled for execution",
              "start": "Activity started",
              "suspend": "Activity suspended mid-execution",
              "withdraw": "Activity withdrawn before completion"
            },
            "constraints": [
              "7 distinct values"
            ]
          },
          "time:timestamp": {
            "type": "string",
            "format": "ISO 8601 datetime with timezone",
            "description": "UTC timestamp when the event occurred",
            "constraints": [
              "Example: 2016-01-01 09:51:15.304000+00:00",
              "Dataset range: 2016–2017"
            ]
          },
          "case:concept:name": {
            "type": "string",
            "description": "Case identifier; links events to the same loan application",
            "constraints": [
              "Format: Application_XXXXXXXXX",
              "492 distinct cases in sample"
            ]
          },
          "case:LoanGoal": {
            "type": "string",
            "format": "enum",
            "description": "Purpose of the loan as stated by applicant",
            "enum": {
              "Boat": "Purchase of a boat",
              "Business goal": "Business-related funding",
              "Car": "Purchase of a car",
              "Caravan / Camper": "Purchase of caravan or camper",
              "Existing loan takeover": "Refinancing an existing loan",
              "Extra spending limit": "Increasing credit limit",
              "Home improvement": "Home renovation or improvement",
              "Motorcycle": "Purchase of a motorcycle",
              "Not speficied": "Loan goal not specified by applicant",
              "Other see explanation": "Other goal with explanation provided",
              "Remaining debt home": "Paying off remaining home debt",
              "Tax payments": "Covering tax obligations",
              "Unknown": "Loan goal unknown"
            },
            "constraints": [
              "13 distinct values",
              "Case-level attribute; constant across events for the same case"
            ]
          },
          "case:ApplicationType": {
            "type": "string",
            "format": "enum",
            "description": "Type of credit application",
            "enum": {
              "Limit raise": "Request to raise existing credit limit",
              "New credit": "Application for new credit product"
            },
            "constraints": [
              "2 distinct values",
              "Case-level attribute; constant across events for the same case"
            ]
          },
          "case:RequestedAmount": {
            "type": "decimal",
            "format": "float",
            "description": "Loan amount requested by the applicant in euros",
            "constraints": [
              "82 distinct values in sample",
              "Example: 20000.0",
              "Case-level attribute; constant across events for the same case"
            ]
          },
          "OfferID": {
            "type": "string",
            "description": "Offer identifier linking event to a specific offer",
            "constraints": [
              "Format: Offer_XXXXXXXXX",
              "761 distinct values in sample",
              "Blank for non-offer events"
            ]
          },
          "OfferedAmount": {
            "type": "decimal",
            "format": "float",
            "description": "Amount offered to the applicant in euros",
            "constraints": [
              "106 distinct values in sample",
              "Blank for non-offer events"
            ]
          },
          "FirstWithdrawalAmount": {
            "type": "decimal",
            "format": "float",
            "description": "First withdrawal amount in euros",
            "constraints": [
              "163 distinct values in sample",
              "Blank when no withdrawal applicable"
            ]
          },
          "NumberOfTerms": {
            "type": "decimal",
            "format": "float",
            "description": "Number of repayment terms in the offer",
            "constraints": [
              "93 distinct values in sample",
              "Stored as float (e.g. 44.0); blank when not applicable"
            ]
          },
          "MonthlyCost": {
            "type": "decimal",
            "format": "float",
            "description": "Monthly repayment amount in euros",
            "constraints": [
              "323 distinct values in sample",
              "Blank when not applicable"
            ]
          },
          "CreditScore": {
            "type": "decimal",
            "format": "float",
            "description": "Applicant credit score at time of offer",
            "constraints": [
              "178 distinct values in sample",
              "Range: 0–1000+",
              "Blank when not assessed"
            ]
          },
          "Accepted": {
            "type": "boolean",
            "format": "enum",
            "description": "Whether the offer was accepted by the applicant",
            "enum": {
              "True": "Offer accepted",
              "False": "Offer not accepted",
              "": "Not applicable (non-offer event)"
            },
            "constraints": [
              "3 distinct values including blank"
            ]
          },
          "Selected": {
            "type": "boolean",
            "format": "enum",
            "description": "Whether the applicant selected this offer",
            "enum": {
              "True": "Offer selected by customer",
              "False": "Offer not selected",
              "": "Not applicable (non-offer event)"
            },
            "constraints": [
              "3 distinct values including blank"
            ]
          }
        }
      },
      "samples": [
