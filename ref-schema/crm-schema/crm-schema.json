          "resolution": "resolved",
          "agentId": "Agent_047",
          "durationMinutes": 8
        },
        {
          "globalId": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
          "interactionId": "d4e5f6a7-b8c9-0123-defa-234567890123",
          "customerId": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
          "channel": "phone",
          "timestamp": "2025-11-15T14:37:12.000Z",
          "topic": "Complaint",
          "resolution": "escalated",
          "agentId": "Agent_012",
          "durationMinutes": 22
        }
      ]
    },
    "ServiceCase": {
      "description": "CRM service case record for complaints, disputes, requests, and inquiries",
      "source": "crm",
      "dataContract": {
        "required": [
          "globalId",
          "caseId",
          "customerId",
          "caseType",
          "subject",
          "status",
          "priority",
          "createdAt",
          "assignedTeam"
        ],
        "fields": {
          "globalId": {
            "type": "string",
            "format": "uuid",
            "description": "Cross-dataset linking key — matches customerId in CDR customers table"
          },
          "caseId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique case identifier"
          },
          "customerId": {
            "type": "string",
            "format": "uuid",
            "description": "Customer this case belongs to, foreign key to CDR CommonPerson"
          },
          "caseType": {
            "type": "string",
            "format": "enum",
            "enum": ["dispute", "complaint", "request", "inquiry"],
            "description": "Category of service case"
          },
          "subject": {
            "type": "string",
            "description": "Brief description of the case subject"
          },
          "status": {
            "type": "string",
            "format": "enum",
            "enum": ["open", "in_progress", "resolved", "closed"],
            "description": "Current case status"
          },
          "priority": {
            "type": "string",
            "format": "enum",
            "enum": ["low", "medium", "high", "critical"],
            "description": "Case priority level"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the case was created"
          },
          "resolvedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the case was resolved; null if still open"
          },
          "resolutionSummary": {
            "type": "string",
            "description": "Summary of how the case was resolved; null if still open"
          },
          "assignedTeam": {
            "type": "string",
            "format": "enum",
            "enum": ["Support", "Complaints", "Escalations", "Fraud"],
            "description": "Team currently responsible for the case"
          }
        }
      },
