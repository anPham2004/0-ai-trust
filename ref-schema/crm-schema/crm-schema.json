    "MissingDocument": {
      "description": "Document checklist tracker per loan application — tracks required, received, and verified documents",
      "source": "crm",
      "dataContract": {
        "required": [
          "globalId",
          "documentId",
          "applicationId",
          "customerId",
          "documentType",
          "status",
          "requestedAt",
          "remindersSent"
        ],
        "fields": {
          "globalId": {
            "type": "string",
            "format": "uuid",
            "description": "Cross-dataset linking key — matches customerId in CDR customers table"
          },
          "documentId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique document record identifier"
          },
          "applicationId": {
            "type": "string",
            "format": "uuid",
            "description": "Loan application requiring this document, foreign key to BPI LoanApplication"
          },
          "customerId": {
            "type": "string",
            "format": "uuid",
            "description": "Customer who must provide the document, foreign key to CDR CommonPerson"
          },
          "documentType": {
            "type": "string",
            "format": "enum",
            "enum": ["payslip", "ID_proof", "address_proof", "bank_statement", "tax_return", "other"],
            "description": "Type of document required"
          },
          "status": {
            "type": "string",
            "format": "enum",
            "enum": ["required", "received", "invalid", "expired", "verified"],
            "description": "Current document status"
          },
          "requestedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the document was first requested"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the document was received; null if not yet submitted"
          },
          "expiryDate": {
            "type": "string",
            "format": "date",
            "description": "Document expiry date; null if not applicable"
          },
          "remindersSent": {
            "type": "number",
            "format": "integer",
            "description": "Number of reminder notifications sent to the customer",
            "constraints": ["Range: 0–10"]
          },
          "lastReminderAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of the most recent reminder; null if no reminders sent"
          },
          "rejectionReason": {
            "type": "string",
            "description": "Reason document was marked invalid; null unless status is invalid"
          }
        }
      },
