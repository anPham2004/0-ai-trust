    "ApplicationStageHistory": {
      "description": "CRM stage timeline for loan applications — maps BPI process events to English CRM stages with SLA tracking",
      "source": "crm",
      "dataContract": {
        "required": [
          "globalId",
          "historyId",
          "applicationId",
          "stage",
          "enteredAt",
          "assignedTeam",
          "assignedTo",
          "slaDeadline"
        ],
        "fields": {
          "globalId": {
            "type": "string",
            "format": "uuid",
            "description": "Cross-dataset linking key — matches customerId in CDR customers table"
          },
          "historyId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique history record identifier"
          },
          "applicationId": {
            "type": "string",
            "format": "uuid",
            "description": "Application moving through stages, foreign key to BPI LoanApplication"
          },
          "stage": {
            "type": "string",
            "format": "enum",
            "enum": [
              "Submitted",
              "Document_Verification",
              "Assessment",
              "Credit_Check",
              "Approved",
              "Conditionally_Approved",
              "Denied",
              "Withdrawn",
              "Cancelled"
            ],
            "description": "CRM stage name. BPI mapping: W_Completeren_aanvraag→Document_Verification, W_Valideren_aanvraag→Assessment, A_Accepted→Approved, A_Denied→Denied"
          },
          "enteredAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the application entered this stage"
          },
          "exitedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the application left this stage; null if this is the current stage"
          },
          "assignedTeam": {
            "type": "string",
            "format": "enum",
            "enum": ["Intake", "Review", "Underwriting", "Compliance"],
            "description": "Team responsible at this stage"
          },
          "assignedTo": {
            "type": "string",
            "description": "Staff member assigned to this stage"
          },
          "slaDeadline": {
            "type": "string",
            "format": "date-time",
            "description": "SLA deadline for completing this stage"
          }
        }
      },
      "samples": [
        {
          "globalId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "historyId": "e1f2a3b4-c5d6-7890-efab-901234567890",
          "applicationId": "c9d0e1f2-a3b4-5678-cdab-789012345678",
          "stage": "Document_Verification",
