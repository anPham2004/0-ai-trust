          "exitedAt": "2025-11-14T16:45:00.000Z",
          "assignedTeam": "Review",
          "assignedTo": "User_031",
          "slaDeadline": "2025-11-15T08:00:00.000Z"
        },
        {
          "globalId": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
          "historyId": "f2a3b4c5-d6e7-8901-fabc-012345678901",
          "applicationId": "d0e1f2a3-b4c5-6789-dabc-890123456789",
          "stage": "Assessment",
          "enteredAt": "2025-11-16T09:15:00.000Z",
          "exitedAt": null,
          "assignedTeam": "Underwriting",
          "assignedTo": "User_058",
          "slaDeadline": "2025-11-19T09:15:00.000Z"
        }
      ]
    },
    "StatusChangeHistory": {
      "description": "Audit log of every application status transition with change reason",
      "source": "crm",
      "dataContract": {
        "required": [
          "globalId",
          "changeId",
          "applicationId",
          "oldStatus",
          "newStatus",
          "changedAt",
          "changedBy",
          "reason"
        ],
        "fields": {
          "globalId": {
            "type": "string",
            "format": "uuid",
            "description": "Cross-dataset linking key — matches customerId in CDR customers table"
          },
          "changeId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique change record identifier"
          },
          "applicationId": {
            "type": "string",
            "format": "uuid",
            "description": "Application that changed status, foreign key to BPI LoanApplication"
          },
          "oldStatus": {
            "type": "string",
            "description": "Previous stage or status value"
          },
          "newStatus": {
            "type": "string",
            "description": "New stage or status value"
          },
          "changedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the status change occurred"
          },
          "changedBy": {
