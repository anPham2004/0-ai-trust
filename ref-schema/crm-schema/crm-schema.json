{
  "meta": {
    "title": "CRM -- Customer Relationship Management Schema Catalog",
    "version": "1.0.0",
    "generatedAt": "2026-07-16",
    "description": "Schema catalog for 6 CRM entity types covering customer preferences, support interactions, service cases, document tracking, application stage history, and status change audit logs. Designed to link with CDR CommonPerson via globalId and BPI LoanApplication via applicationId."
  },
  "entities": {
    "CustomerPreferences": {
      "description": "Customer communication preferences and satisfaction score, linked 1:1 to CDR CommonPerson",
      "source": "crm",
      "dataContract": {
        "required": [
          "globalId",
          "customerId",
          "preferredContactChannel",
          "preferredLanguage",
          "marketingOptIn"
        ],
        "fields": {
          "globalId": {
            "type": "string",
            "format": "uuid",
            "description": "Cross-dataset linking key — matches customerId in CDR customers table"
          },
          "customerId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique customer identifier, foreign key to CDR CommonPerson"
          },
          "preferredContactChannel": {
            "type": "string",
            "format": "enum",
            "enum": ["phone", "email", "sms", "chat"],
            "description": "Customer's preferred communication channel"
          },
          "preferredLanguage": {
            "type": "string",
            "description": "Preferred language for communications",
            "constraints": ["ISO 639-1 language code"]
          },
          "marketingOptIn": {
            "type": "boolean",
            "description": "Whether customer consents to marketing communications"
          },
          "satisfactionScore": {
            "type": "number",
            "description": "Overall customer satisfaction score derived from service interactions",
            "constraints": ["Range: 0.0–5.0", "One decimal place"]
          }
        }
      },
      "samples": [
        {
          "globalId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "customerId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "preferredContactChannel": "email",
          "preferredLanguage": "en",
          "marketingOptIn": true,
          "satisfactionScore": 4.2
        },
        {
          "globalId": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
          "customerId": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
          "preferredContactChannel": "phone",
          "preferredLanguage": "es",
          "marketingOptIn": false,
          "satisfactionScore": 3.7
        }
      ]
    },
    "SupportInteraction": {
      "description": "Record of every customer contact with support staff across all channels",
      "source": "crm",
      "dataContract": {
        "required": [
          "globalId",
          "interactionId",
          "customerId",
          "channel",
          "timestamp",
          "topic",
          "resolution",
          "agentId",
          "durationMinutes"
        ],
        "fields": {
          "globalId": {
            "type": "string",
            "format": "uuid",
            "description": "Cross-dataset linking key — matches customerId in CDR customers table"
          },
          "interactionId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for this support interaction"
          },
          "customerId": {
            "type": "string",
            "format": "uuid",
            "description": "Customer who initiated the contact, foreign key to CDR CommonPerson"
          },
          "channel": {
            "type": "string",
            "format": "enum",
            "enum": ["phone", "email", "chat", "branch"],
            "description": "Contact channel used"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "When the interaction occurred"
          },
          "topic": {
            "type": "string",
            "format": "enum",
            "enum": ["Account_Inquiry", "Application_Status", "Document_Upload", "Complaint", "General"],
            "description": "Subject category of the interaction"
          },
          "resolution": {
            "type": "string",
            "format": "enum",
            "enum": ["resolved", "escalated", "follow_up_required", "unresolved"],
            "description": "Outcome of the interaction"
          },
          "agentId": {
            "type": "string",
            "description": "Identifier of the staff member who handled the interaction"
          },
          "durationMinutes": {
            "type": "number",
            "format": "integer",
            "description": "Length of the interaction in minutes",
            "constraints": ["Positive integer"]
          }
        }
      },
      "samples": [
        {
          "globalId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "interactionId": "c3d4e5f6-a7b8-9012-cdef-123456789012",
          "customerId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "channel": "chat",
          "timestamp": "2025-11-14T09:23:45.000Z",
